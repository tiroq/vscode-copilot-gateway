{
  "name": "copilot-gateway",
  "displayName": "Copilot Gateway",
  "description": "Expose GitHub Copilot as a local OpenAI-compatible HTTP API",
  "version": "1.0.0",
  "publisher": "tiroq",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "copilot",
    "openai",
    "api",
    "gateway",
    "language-model"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilot-gateway.start",
        "title": "Start Gateway Server",
        "category": "Copilot Gateway"
      },
      {
        "command": "copilot-gateway.stop",
        "title": "Stop Gateway Server",
        "category": "Copilot Gateway"
      },
      {
        "command": "copilot-gateway.restart",
        "title": "Restart Gateway Server",
        "category": "Copilot Gateway"
      },
      {
        "command": "copilot-gateway.showDashboard",
        "title": "Show Dashboard",
        "category": "Copilot Gateway"
      }
    ],
    "configuration": {
      "title": "Copilot Gateway",
      "properties": {
        "copilot-gateway.port": {
          "type": "number",
          "default": 8080,
          "description": "HTTP server port",
          "minimum": 1024,
          "maximum": 65535
        },
        "copilot-gateway.authToken": {
          "type": "string",
          "default": "",
          "description": "Optional Bearer authentication token (leave empty to disable auth)"
        },
        "copilot-gateway.maxConcurrentRequests": {
          "type": "number",
          "default": 5,
          "description": "Maximum number of concurrent requests",
          "minimum": 1,
          "maximum": 50
        },
        "copilot-gateway.retryAttempts": {
          "type": "number",
          "default": 3,
          "description": "Maximum retry attempts for failed requests",
          "minimum": 0,
          "maximum": 10
        },
        "copilot-gateway.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start server on extension activation"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "eslint": "^8.x",
    "typescript": "^5.3.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/tiroq/vscode-copilot-gateway"
  },
  "license": "MIT"
}
